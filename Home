<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MCU Watchlist Tracker – Road to Doomsday</title>
  <style>
    :root {
      --bg-color: #0b0d13;
      --card-bg: #151924;
      --card-hover: #1c2230;
      --marvel-red: #e62429;
      --marvel-red-glow: rgba(230, 36, 41, 0.35);
      --doom-green: #10b981;
      --doom-green-bg: rgba(16, 185, 129, 0.14);
      --doom-green-border: rgba(16, 185, 129, 0.45);
      --text-main: #f3f4f6;
      --text-muted: #9ca3af;
      --border-color: #262c3d;
      --badge-film: #2563eb;
      --badge-serie: #7c3aed;
      --badge-special: #d97706;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      line-height: 1.5;
      padding: 1rem;
      padding-bottom: 4rem;
    }

    header {
      background: rgba(11, 13, 19, 0.92);
      border-bottom: 1px solid var(--border-color);
      padding: 1rem;
      border-radius: 10px;
      margin-bottom: 1.5rem;
    }

    .header-content { max-width: 920px; margin: 0 auto; }
    .title-row { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 0.75rem; }
    .logo { display: flex; align-items: center; gap: 0.75rem; font-size: 1.4rem; font-weight: 800; }
    .logo span { background-color: var(--marvel-red); color: #fff; padding: 0.15rem 0.55rem; border-radius: 4px; font-size: 1.1rem; }
    .stats { font-size: 0.9rem; font-weight: 600; color: var(--text-muted); }
    .stats strong { color: var(--text-main); }
    .progress-container { width: 100%; height: 8px; background-color: #1f2433; border-radius: 999px; overflow: hidden; }
    .progress-bar { height: 100%; width: 0%; background: linear-gradient(90deg, #b91c1c, var(--marvel-red), #ff5257); transition: width 0.3s ease; }

    main { max-width: 920px; margin: 0 auto; }
    .controls { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1.5rem; justify-content: space-between; align-items: center; }
    .search-box { flex: 1 1 200px; padding: 0.6rem 1rem; border-radius: 8px; border: 1px solid var(--border-color); background-color: var(--card-bg); color: var(--text-main); font-size: 0.95rem; outline: none; }
    .search-box:focus { border-color: var(--marvel-red); }
    .filter-group { display: flex; flex-wrap: wrap; gap: 0.4rem; }

    button {
      background-color: var(--card-bg); color: var(--text-muted); border: 1px solid var(--border-color);
      padding: 0.5rem 0.85rem; border-radius: 8px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.2s;
    }
    button:hover { background-color: var(--card-hover); color: var(--text-main); }
    button.active { background-color: var(--marvel-red); border-color: var(--marvel-red); color: #fff; }
    button.doom-filter.active { background-color: var(--doom-green); border-color: var(--doom-green); color: #052e16; }

    .doom-banner {
      background: linear-gradient(90deg, rgba(16, 185, 129, 0.12), rgba(21, 25, 36, 0.9));
      border: 1px solid var(--doom-green-border); border-radius: 10px; padding: 0.85rem 1.1rem;
      margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; font-size: 0.9rem;
    }
    .doom-banner strong { color: var(--doom-green); }

    .saga-title { font-size: 1.3rem; font-weight: 800; text-transform: uppercase; color: var(--marvel-red); margin: 2rem 0 1rem; padding-bottom: 0.4rem; border-bottom: 2px solid var(--border-color); }
    .phase-block { margin-bottom: 1.5rem; }
    .phase-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
    .phase-header h3 { font-size: 1.1rem; font-weight: 700; }
    .phase-count { font-size: 0.8rem; color: var(--text-muted); background: var(--card-bg); padding: 0.2rem 0.6rem; border-radius: 999px; border: 1px solid var(--border-color); }

    .item-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .item-card {
      display: flex; align-items: center; gap: 1rem; background-color: var(--card-bg);
      border: 1px solid var(--border-color); padding: 0.75rem 1rem; border-radius: 10px; cursor: pointer; user-select: none;
    }
    .item-card.is-doomsday { border-left: 4px solid var(--doom-green); }
    .item-card:hover { background-color: var(--card-hover); }
    .item-card.watched { opacity: 0.55; background-color: #10131c; }
    .item-card.watched .item-title { text-decoration: line-through; color: var(--text-muted); }

    .checkbox { width: 20px; height: 20px; border-radius: 5px; border: 2px solid #4b5563; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .item-card.watched .checkbox { background-color: var(--marvel-red); border-color: var(--marvel-red); }
    .checkbox svg { width: 12px; height: 12px; stroke: #fff; stroke-width: 3; fill: none; opacity: 0; }
    .item-card.watched .checkbox svg { opacity: 1; }

    .item-info { flex: 1; display: flex; flex-direction: column; }
    .item-title { font-weight: 600; font-size: 0.95rem; }
    .item-date { font-size: 0.75rem; color: var(--text-muted); }

    .badges-wrapper { display: flex; align-items: center; gap: 0.4rem; justify-content: flex-end; }
    .badge { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; padding: 0.2rem 0.5rem; border-radius: 5px; color: #fff; }
    .badge.Film { background-color: var(--badge-film); }
    .badge.Serie { background-color: var(--badge-serie); }
    .badge.Special { background-color: var(--badge-special); }
    .badge.doom { background-color: var(--doom-green-bg); color: var(--doom-green); border: 1px solid var(--doom-green-border); }
    .empty-state { text-align: center; padding: 2rem; color: var(--text-muted); }
  </style>
</head>
<body>

  <header>
    <div class="header-content">
      <div class="title-row">
        <div class="logo"><span>MARVEL</span> Watchlist</div>
        <div class="stats" id="stats-text">0 / 0 gesehen (0%)</div>
      </div>
      <div class="progress-container">
        <div class="progress-bar" id="progress-bar"></div>
      </div>
    </div>
  </header>

  <main>
    <div class="controls">
      <input type="text" id="search-input" class="search-box" placeholder="Titel suchen..." />
      <div class="filter-group">
        <button class="filter-btn active" data-filter="all">Alle</button>
        <button class="filter-btn doom-filter" data-filter="doomsday">⚡ Doomsday</button>
        <button class="filter-btn" data-filter="Film">Filme</button>
        <button class="filter-btn" data-filter="Serie">Serien</button>
        <button class="filter-btn" data-filter="unwatched">Ungesehen</button>
        <button class="reset-btn" id="reset-btn">Reset</button>
      </div>
    </div>

    <div class="doom-banner">
      <div>⚡ <strong>Road to Doomsday</strong> – Grün markierte Titel.</div>
      <div id="doom-stats" style="font-weight: 600; color: var(--doom-green);">0 / 0 gesehen</div>
    </div>

    <div id="list-container"></div>
  </main>

  <script>
    const mcuData = [
      {
        saga: "Die Infinity-Saga",
        phases: [
          {
            name: "Phase 1 (2008–2012)",
            items: [
              { id: "p1-1", title: "Iron Man", type: "Film", date: "Mai 2008", doomsday: true },
              { id: "p1-2", title: "Der unglaubliche Hulk", type: "Film", date: "Juni 2008", doomsday: false },
              { id: "p1-3", title: "Iron Man 2", type: "Film", date: "Mai 2010", doomsday: false },
              { id: "p1-4", title: "Thor", type: "Film", date: "April 2011", doomsday: true },
              { id: "p1-5", title: "Captain America: The First Avenger", type: "Film", date: "Juli 2011", doomsday: true },
              { id: "p1-6", title: "Marvel’s The Avengers", type: "Film", date: "April 2012", doomsday: true }
            ]
          },
          {
            name: "Phase 2 (2013–2015)",
            items: [
              { id: "p2-1", title: "Iron Man 3", type: "Film", date: "Mai 2013", doomsday: false },
              { id: "p2-2", title: "Thor – The Dark Kingdom", type: "Film", date: "Oktober 2013", doomsday: false },
              { id: "p2-3", title: "The Return of the First Avenger", type: "Film", date: "März 2014", doomsday: true },
              { id: "p2-4", title: "Guardians of the Galaxy", type: "Film", date: "August 2014", doomsday: false },
              { id: "p2-5", title: "Avengers: Age of Ultron", type: "Film", date: "April 2015", doomsday: true },
              { id: "p2-6", title: "Ant-Man", type: "Film", date: "Juli 2015", doomsday: true }
            ]
          },
          {
            name: "Phase 3 (2016–2019)",
            items: [
              { id: "p3-1", title: "The First Avenger: Civil War", type: "Film", date: "April 2016", doomsday: true },
              { id: "p3-2", title: "Doctor Strange", type: "Film", date: "Oktober 2016", doomsday: true },
              { id: "p3-3", title: "Guardians of the Galaxy Vol. 2", type: "Film", date: "April 2017", doomsday: false },
              { id: "p3-4", title: "Spider-Man: Homecoming", type: "Film", date: "Juli 2017", doomsday: false },
              { id: "p3-5", title: "Thor: Tag der Entscheidung", type: "Film", date: "Oktober 2017", doomsday: true },
              { id: "p3-6", title: "Black Panther", type: "Film", date: "Februar 2018", doomsday: true },
              { id: "p3-7", title: "Avengers: Infinity War", type: "Film", date: "April 2018", doomsday: true },
              { id: "p3-8", title: "Ant-Man and the Wasp", type: "Film", date: "Juli 2018", doomsday: false },
              { id: "p3-9", title: "Captain Marvel", type: "Film", date: "März 2019", doomsday: false },
              { id: "p3-10", title: "Avengers: Endgame", type: "Film", date: "April 2019", doomsday: true },
              { id: "p3-11", title: "Spider-Man: Far From Home", type: "Film", date: "Juli 2019", doomsday: false }
            ]
          }
        ]
      },
      {
        saga: "Die Multiverse-Saga",
        phases: [
          {
            name: "Phase 4 (2021–2022)",
            items: [
              { id: "p4-1", title: "WandaVision", type: "Serie", date: "Jan.–März 2021", doomsday: true },
              { id: "p4-2", title: "The Falcon and the Winter Soldier", type: "Serie", date: "März–April 2021", doomsday: true },
              { id: "p4-3", title: "Loki – Staffel 1", type: "Serie", date: "Juni–Juli 2021", doomsday: true },
              { id: "p4-4", title: "Black Widow", type: "Film", date: "Juli 2021", doomsday: true },
              { id: "p4-5", title: "What If…? – Staffel 1", type: "Serie", date: "Aug.–Okt. 2021", doomsday: false },
              { id: "p4-6", title: "Shang-Chi and the Legend of the Ten Rings", type: "Film", date: "September 2021", doomsday: true },
              { id: "p4-7", title: "Eternals", type: "Film", date: "November 2021", doomsday: false },
              { id: "p4-8", title: "Hawkeye", type: "Serie", date: "Nov.–Dez. 2021", doomsday: false },
              { id: "p4-9", title: "Spider-Man: No Way Home", type: "Film", date: "Dezember 2021", doomsday: true },
              { id: "p4-10", title: "Moon Knight", type: "Serie", date: "März–Mai 2022", doomsday: false },
              { id: "p4-11", title: "Doctor Strange in the Multiverse of Madness", type: "Film", date: "Mai 2022", doomsday: true },
              { id: "p4-12", title: "Ms. Marvel", type: "Serie", date: "Juni–Juli 2022", doomsday: false },
              { id: "p4-13", title: "Thor: Love and Thunder", type: "Film", date: "Juli 2022", doomsday: false },
              { id: "p4-14", title: "Ich bin Groot – Staffel 1", type: "Serie", date: "August 2022", doomsday: false },
              { id: "p4-15", title: "She-Hulk: Die Anwältin", type: "Serie", date: "Aug.–Okt. 2022", doomsday: false },
              { id: "p4-16", title: "Werewolf by Night", type: "Special", date: "Oktober 2022", doomsday: false },
              { id: "p4-17", title: "Black Panther: Wakanda Forever", type: "Film", date: "November 2022", doomsday: true },
              { id: "p4-18", title: "The Guardians of the Galaxy Holiday Special", type: "Special", date: "November 2022", doomsday: false }
            ]
          },
          {
            name: "Phase 5 (2023–2025)",
            items: [
              { id: "p5-1", title: "Ant-Man and the Wasp: Quantumania", type: "Film", date: "Februar 2023", doomsday: true },
              { id: "p5-2", title: "Guardians of the Galaxy Vol. 3", type: "Film", date: "Mai 2023", doomsday: false },
              { id: "p5-3", title: "Secret Invasion", type: "Serie", date: "Juni–Juli 2023", doomsday: false },
              { id: "p5-4", title: "Ich bin Groot – Staffel 2", type: "Serie", date: "September 2023", doomsday: false },
              { id: "p5-5", title: "Loki – Staffel 2", type: "Serie", date: "Okt.–Nov. 2023", doomsday: true },
              { id: "p5-6", title: "The Marvels", type: "Film", date: "November 2023", doomsday: true },
              { id: "p5-7", title: "What If…? – Staffel 2", type: "Serie", date: "Dezember 2023", doomsday: false },
              { id: "p5-8", title: "Echo", type: "Serie", date: "Januar 2024", doomsday: false },
              { id: "p5-9", title: "Deadpool & Wolverine", type: "Film", date: "Juli 2024", doomsday: true },
              { id: "p5-10", title: "Agatha All Along", type: "Serie", date: "Sept.–Okt. 2024", doomsday: false },
              { id: "p5-11", title: "What If…? – Staffel 3", type: "Serie", date: "Dezember 2024", doomsday: false },
              { id: "p5-12", title: "Der freundliche Spider-Man aus der Nachbarschaft – Staffel 1", type: "Serie", date: "Jan.–Feb. 2025", doomsday: false },
              { id: "p5-13", title: "Captain America: Brave New World", type: "Film", date: "Februar 2025", doomsday: true },
              { id: "p5-14", title: "Daredevil: Born Again – Staffel 1", type: "Serie", date: "März–April 2025", doomsday: false },
              { id: "p5-15", title: "Thunderbolts*", type: "Film", date: "Mai 2025", doomsday: true },
              { id: "p5-16", title: "Ironheart", type: "Serie", date: "Juni–Juli 2025", doomsday: false }
            ]
          },
          {
            name: "Phase 6 (ab Juli 2025)",
            items: [
              { id: "p6-1", title: "The Fantastic Four: First Steps", type: "Film", date: "Juli 2025", doomsday: true },
              { id: "p6-2", title: "Eyes of Wakanda", type: "Serie", date: "August 2025", doomsday: false },
              { id: "p6-3", title: "Marvel Zombies", type: "Serie", date: "September 2025", doomsday: false },
              { id: "p6-4", title: "Wonder Man", type: "Serie", date: "Januar 2026", doomsday: false },
              { id: "p6-5", title: "Daredevil: Born Again – Staffel 2", type: "Serie", date: "März–Mai 2026", doomsday: false },
              { id: "p6-6", title: "The Punisher: One Last Kill", type: "Special", date: "Mai 2026", doomsday: false },
              { id: "p6-7", title: "Spider-Man: Brand New Day", type: "Film", date: "Juli 2026", doomsday: true },
              { id: "p6-8", title: "VisionQuest", type: "Serie", date: "Okt.–Nov. 2026", doomsday: false }
            ]
          }
        ]
      }
    ];

    const STORAGE_KEY = "mcu_watched_items_v1";
    let watchedSet = new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]"));
    let currentFilter = "all";
    let searchQuery = "";

    const listContainer = document.getElementById("list-container");
    const statsText = document.getElementById("stats-text");
    const doomStatsText = document.getElementById("doom-stats");
    const progressBar = document.getElementById("progress-bar");
    const searchInput = document.getElementById("search-input");
    const filterButtons = document.querySelectorAll(".filter-btn");
    const resetBtn = document.getElementById("reset-btn");

    function saveProgress() { localStorage.setItem(STORAGE_KEY, JSON.stringify([...watchedSet])); }

    function toggleWatched(id) {
      if (watchedSet.has(id)) watchedSet.delete(id);
      else watchedSet.add(id);
      saveProgress();
      render();
    }

    function updateProgress() {
      let total = 0, doomTotal = 0, doomWatched = 0;
      mcuData.forEach(saga => saga.phases.forEach(phase => {
        phase.items.forEach(item => {
          total++;
          if (item.doomsday) { doomTotal++; if (watchedSet.has(item.id)) doomWatched++; }
        });
      }));
      const watchedCount = watchedSet.size;
      const percentage = total === 0 ? 0 : Math.round((watchedCount / total) * 100);
      statsText.innerHTML = `<strong>${watchedCount}</strong> / ${total} (${percentage}%)`;
      doomStatsText.textContent = `${doomWatched} / ${doomTotal}`;
      progressBar.style.width = `${percentage}%`;
    }

    function render() {
      listContainer.innerHTML = "";
      let visibleCount = 0;

      mcuData.forEach(saga => {
        const sagaWrapper = document.createElement("div");
        let sagaHasItems = false;
        const sagaHeading = document.createElement("h2");
        sagaHeading.className = "saga-title";
        sagaHeading.textContent = saga.saga;
        sagaWrapper.appendChild(sagaHeading);

        saga.phases.forEach(phase => {
          const filteredItems = phase.items.filter(item => {
            const matchesSearch = item.title.toLowerCase().includes(searchQuery.toLowerCase());
            if (!matchesSearch) return false;
            if (currentFilter === "doomsday") return item.doomsday === true;
            if (currentFilter === "Film") return item.type === "Film";
            if (currentFilter === "Serie") return item.type === "Serie" || item.type === "Special";
            if (currentFilter === "unwatched") return !watchedSet.has(item.id);
            return true;
          });

          if (filteredItems.length === 0) return;
          sagaHasItems = true;
          visibleCount += filteredItems.length;

          const phaseBlock = document.createElement("section");
          phaseBlock.className = "phase-block";
          const watchedInPhase = phase.items.filter(i => watchedSet.has(i.id)).length;
          phaseBlock.innerHTML = `
            <div class="phase-header">
              <h3>${phase.name}</h3>
              <span class="phase-count">${watchedInPhase} / ${phase.items.length}</span>
            </div>
          `;

          const itemList = document.createElement("div");
          itemList.className = "item-list";

          filteredItems.forEach(item => {
            const isWatched = watchedSet.has(item.id);
            const card = document.createElement("div");
            card.className = `item-card ${isWatched ? "watched" : ""} ${item.doomsday ? "is-doomsday" : ""}`;
            card.onclick = () => toggleWatched(item.id);

            const doomBadge = item.doomsday ? `<span class="badge doom">⚡ Doomsday</span>` : "";
            card.innerHTML = `
              <div class="checkbox"><svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg></div>
              <div class="item-info">
                <span class="item-title">${item.title}</span>
                <span class="item-date">${item.date}</span>
              </div>
              <div class="badges-wrapper">
                ${doomBadge}
                <span class="badge ${item.type}">${item.type}</span>
              </div>
            `;
            itemList.appendChild(card);
          });

          phaseBlock.appendChild(itemList);
          sagaWrapper.appendChild(phaseBlock);
        });

        if (sagaHasItems) listContainer.appendChild(sagaWrapper);
      });

      if (visibleCount === 0) listContainer.innerHTML = `<div class="empty-state">Keine Titel gefunden.</div>`;
      updateProgress();
    }

    searchInput.addEventListener("input", (e) => { searchQuery = e.target.value; render(); });
    filterButtons.forEach(btn => {
      btn.addEventListener("click", () => {
        filterButtons.forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        currentFilter = btn.dataset.filter;
        render();
      });
    });

    resetBtn.addEventListener("click", () => {
      if (confirm("Fortschritt wirklich zurücksetzen?")) {
        watchedSet.clear();
        saveProgress();
        render();
      }
    });

    render();
  </script>
</body>
</html>
